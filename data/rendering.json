{
  "$schema": "./schemas/rendering.schema.json",
  "_comment": "Presentation settings (not simulation). All values are placeholders. Colours are either '#RRGGBB' or a reference into branding.json colors ('lawn' = first entry, 'brick:2' = third entry), so the §28.2 palette stays in one place.",
  "crowd": {
    "_comment": "Rendered walkers are a cosmetic sample of real sim walks (§30.2 two-level movement). They move at visual_walk_speed_mps × game speed, decoupled from the game clock (at 1×, one in-game hour lasts 83 ms of real time).",
    "max_rendered_agents": 2000,
    "visual_walk_speed_mps": 12,
    "lateral_spread_m": 3.0,
    "spawn_attempts_per_free_slot": 4,
    "view_margin_m": 60,
    "detail_radius_factor": 2.5,
    "detail_radius_min_m": 150,
    "agent_height_m": 1.8,
    "agent_radius_m": 0.35,
    "size_compensation_reference_distance_m": 150,
    "size_compensation_max_scale": 6
  },
  "agent_colors": {
    "student_by_year": ["#C3142D", "#E0A526", "#3E7CB1", "#5B8C5A"],
    "faculty": "#6B4F3A"
  },
  "buildings": {
    "height_m": { "academic": 14, "residence": 16, "dining": 8, "library": 18, "recreation": 12, "off_campus_housing": 9, "other": 8 },
    "color": { "academic": "brick:1", "residence": "brick", "dining": "brick:2", "library": "limestone", "recreation": "brick:2", "off_campus_housing": "slate", "other": "slate" }
  },
  "ground": {
    "grass": "lawn",
    "path": "brick:2",
    "building": "slate",
    "wear": "#8B6B4A",
    "wear_full_at_walkers": 20000,
    "heatmap_low": "#2B83BA",
    "heatmap_high": "#D7191C",
    "refresh_seconds": 0.5
  },
  "terrain": {
    "_comment": "Spike B low-poly terrain. Chunks of chunk_size_tiles²; LOD k uses lod_steps[k] tiles per quad and is shown from lod_switch_m[k-1] metres. Land colours blend between four seasons (anchor days: winter 15, spring 105, summer 196, fall 293). Roads use the era's surface (eras.json road_type) until the asphalt era, then path_colors by class.",
    "chunk_size_tiles": 40,
    "lod_steps": [1, 2, 4],
    "lod_switch_m": [900, 2000],
    "skirt_depth_m": 6,
    "season_colors": {
      "winter": { "forest": "#6E6A5E", "pasture": "#D9DCD6", "farmland": "#DADDD8", "town": "#C9CCC6", "university": "#E3E6E1", "developed": "#C4C4BE", "protected": "#6A665A", "water": "#7F9DB3" },
      "spring": { "forest": "#5E8C3E", "pasture": "#A7CF6E", "farmland": "#8C7453", "town": "#A8B893", "university": "#8CC063", "developed": "#B7B09A", "protected": "#577F3A", "water": "#5B8FC0" },
      "summer": { "forest": "#3F6B35", "pasture": "#9DBF6A", "farmland": "#C9B56A", "town": "#A9B08A", "university": "lawn", "developed": "#B7B09A", "protected": "#35602F", "water": "#4F87B8" },
      "fall":   { "forest": "#B0632B", "pasture": "#B7A66A", "farmland": "#C8A050", "town": "#B6A777", "university": "#9FB56A", "developed": "#B7B09A", "protected": "#9A5A2A", "water": "#4A7AA6" }
    },
    "season_anchor_days": { "winter": 15, "spring": 105, "summer": 196, "fall": 293 },
    "road_surface_colors": { "dirt": "#9C8061", "gravel": "#A9A39A", "brick": "#8A5E50", "asphalt": "#666563" },
    "path_colors": {
      "footway": "brick:2", "cycleway": "#9A8F86", "service": "#8E8C88", "residential": "#6F6E6C",
      "tertiary": "#666563", "secondary": "#5E5D5B", "primary": "#555452", "railway": "#4A4038"
    },
    "building": "slate",
    "grid_color": "#FFFFFF",
    "grid_opacity": 0.35,
    "grid_fade_start_m": 250,
    "grid_fade_end_m": 900,
    "hover_color": "#FFD23F",
    "hover_opacity": 0.6
  },
  "extrusion": {
    "_comment": "Building footprints extruded to simple boxes (Spike B 3c). Height = OSM height, else levels × level_height_m, else the kind default.",
    "level_height_m": 3.5,
    "min_height_m": 3,
    "kind_height_m": { "academic": 14, "residence": 14, "dining": 8, "library": 16, "student_life": 10, "athletics": 12, "admin": 10, "house": 8, "utility": 6, "landmark": 10, "other": 8 },
    "undated_campus_height_m": 12,
    "town_height_m": 7,
    "kind_colors": { "academic": "brick:1", "residence": "brick", "dining": "brick:2", "library": "limestone", "student_life": "brick:2", "athletics": "slate", "admin": "brick:1", "house": "trim", "utility": "slate", "landmark": "limestone", "other": "slate" },
    "undated_campus_color": "brick:2",
    "town_color": "#C9BFA8",
    "approximate_site_color": "#D9A08E"
  },
  "sun": {
    "_comment": "Sun position from SolarPosition for the map centre; standard time (no daylight saving).",
    "utc_offset_hours": -5,
    "max_energy": 1.3,
    "twilight_elevation_deg": 6,
    "night_ambient_energy": 0.2,
    "day_ambient_energy": 1.0
  },
  "camera": {
    "start_distance_m": 900,
    "min_distance_m": 25,
    "max_distance_m": 3500,
    "start_pitch_deg": 55,
    "min_pitch_deg": 20,
    "max_pitch_deg": 85,
    "keyboard_pan_speed": 0.8,
    "orbit_speed_deg_per_s": 90,
    "mouse_orbit_deg_per_px": 0.25,
    "zoom_step": 1.15
  }
}
