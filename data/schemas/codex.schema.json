{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "History Book entry (§19.3, §30.4: one file per entry in /data/codex)",
  "type": "object",
  "required": ["id", "title", "era_years", "text", "unlock", "sources", "verified"],
  "additionalProperties": false,
  "patternProperties": { "^_": {} },
  "properties": {
    "$schema": { "type": "string" },
    "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
    "title": { "type": "string" },
    "era_years": { "type": "string", "description": "e.g. 1809 or 1824-1841" },
    "text": { "type": "string" },
    "unlock": { "enum": ["start", "event"], "description": "start = known from the beginning; event = unlocked by an event card" },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["title", "url"],
        "additionalProperties": false,
        "properties": { "title": { "type": "string" }, "url": { "type": "string", "pattern": "^https://" } }
      }
    },
    "verified": { "type": "boolean" }
  }
}
