{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "A game start: date, map year, starting money and population, starting university land",
  "type": "object",
  "required": [
    "id",
    "name",
    "start_date",
    "map_year",
    "verified",
    "seed",
    "starting_cash",
    "students",
    "faculty",
    "campus"
  ],
  "additionalProperties": false,
  "patternProperties": {
    "^_": {}
  },
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "start_date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "map_year": {
      "type": "integer",
      "minimum": 1809,
      "maximum": 2200
    },
    "verified": {
      "type": "boolean"
    },
    "seed": {
      "type": "integer",
      "minimum": 0
    },
    "starting_cash": {
      "type": "number",
      "minimum": 0
    },
    "students": {
      "type": "integer",
      "minimum": 0
    },
    "faculty": {
      "type": "integer",
      "minimum": 0
    },
    "campus": {
      "description": "Starting university land for historic starts; null = present-day ownership from the map",
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "center_timeline_id",
            "half_size_m"
          ],
          "additionalProperties": false,
          "patternProperties": {
            "^_": {}
          },
          "properties": {
            "center_timeline_id": {
              "type": "string"
            },
            "half_size_m": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        }
      ]
    },
    "enrollment": {
      "type": "boolean",
      "description": "students arrive, graduate and leave by enrollment.json (1h); false = fixed population"
    },
    "population_capacity": {
      "type": "integer",
      "minimum": 1
    },
    "goals": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^_": {}
      },
      "required": [
        "students",
        "residence_hall",
        "deadline",
        "bankrupt_below",
        "bankrupt_reviews"
      ],
      "properties": {
        "students": {
          "type": "integer",
          "minimum": 1
        },
        "residence_hall": {
          "type": "boolean"
        },
        "deadline": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "bankrupt_below": {
          "type": "number"
        },
        "bankrupt_reviews": {
          "type": "integer",
          "minimum": 1
        },
        "residence_hall_defs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
