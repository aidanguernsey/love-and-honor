{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Eras: unlock tables, prices, road types, clothing sets",
  "type": "object",
  "required": ["eras"],
  "patternProperties": { "^_": {} },
  "properties": {
    "$schema": { "type": "string" },
    "eras": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "start_year", "end_year", "road_type", "clothing_set", "price_multiplier"],
        "additionalProperties": false,
        "patternProperties": { "^_": {} },
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
          "name": { "type": "string" },
          "start_year": { "type": "integer" },
          "end_year": { "type": ["integer", "null"] },
          "road_type": { "enum": ["dirt", "gravel", "brick", "asphalt"] },
          "clothing_set": { "type": "string" },
          "price_multiplier": { "type": "number", "exclusiveMinimum": 0 }
        }
      }
    }
  },
  "additionalProperties": false
}
