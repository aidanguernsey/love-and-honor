{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Building placement and construction settings (§12.1, §5.1b)",
  "type": "object",
  "required": ["rotation_step_deg", "max_slope_m", "path_access", "construction", "heritage"],
  "additionalProperties": false,
  "patternProperties": { "^_": {} },
  "$defs": {
    "months": { "type": "array", "items": { "type": "integer", "minimum": 1, "maximum": 12 }, "uniqueItems": true }
  },
  "properties": {
    "$schema": { "type": "string" },
    "rotation_step_deg": { "type": "integer", "minimum": 1, "maximum": 90 },
    "max_slope_m": { "type": "number", "exclusiveMinimum": 0 },
    "path_access": {
      "type": "object",
      "required": ["required"],
      "additionalProperties": false,
      "patternProperties": { "^_": {} },
      "properties": { "required": { "type": "boolean" } }
    },
    "construction": {
      "type": "object",
      "required": ["days_per_month", "size_classes", "summer_months", "summer_speed", "winter_months", "winter_speed", "cancel_refund_fraction"],
      "additionalProperties": false,
      "patternProperties": { "^_": {} },
      "properties": {
        "days_per_month": { "type": "number", "exclusiveMinimum": 0 },
        "size_classes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "max_tiles", "months"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string" },
              "max_tiles": { "type": ["integer", "null"], "minimum": 1 },
              "months": { "type": "number", "exclusiveMinimum": 0 }
            }
          }
        },
        "summer_months": { "$ref": "#/$defs/months" },
        "summer_speed": { "type": "number", "exclusiveMinimum": 0 },
        "winter_months": { "$ref": "#/$defs/months" },
        "winter_speed": { "type": "number", "exclusiveMinimum": 0 },
        "cancel_refund_fraction": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "heritage": {
      "type": "object",
      "required": ["available_years_before_real", "on_site_min_overlap", "snap_distance_m", "on_site_bonus"],
      "additionalProperties": false,
      "patternProperties": { "^_": {} },
      "properties": {
        "available_years_before_real": { "type": "integer", "minimum": 0 },
        "on_site_min_overlap": { "type": "number", "minimum": 0, "maximum": 1 },
        "snap_distance_m": { "type": "number", "minimum": 0 },
        "on_site_bonus": { "type": "number", "minimum": 0 }
      }
    }
  }
}
