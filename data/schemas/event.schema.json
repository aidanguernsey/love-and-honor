{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Event card (§23, §30.4: one file per event in /data/events)",
  "type": "object",
  "required": ["id", "title", "kind", "text", "effects", "verified"],
  "additionalProperties": false,
  "patternProperties": { "^_": {} },
  "$defs": {
    "source": {
      "type": "object",
      "required": ["title", "url"],
      "additionalProperties": false,
      "properties": { "title": { "type": "string" }, "url": { "type": "string", "pattern": "^https://" } }
    }
  },
  "properties": {
    "$schema": { "type": "string" },
    "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
    "title": { "type": "string" },
    "kind": { "enum": ["historical", "generic"], "description": "historical = a real, sourced event on its date; generic = a fictional era event that can happen any year in its window" },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "description": "historical: when it fires" },
    "date_precision": { "enum": ["day", "month", "year"] },
    "window": {
      "type": "object",
      "required": ["from_year", "to_year", "months", "chance_per_year"],
      "additionalProperties": false,
      "properties": {
        "from_year": { "type": "integer" },
        "to_year": { "type": "integer" },
        "months": { "type": "array", "items": { "type": "integer", "minimum": 1, "maximum": 12 }, "minItems": 1 },
        "chance_per_year": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "text": { "type": "string" },
    "heritage_project": { "type": "string", "description": "if the player has already built this Heritage Project, text_if_built is shown instead" },
    "text_if_built": { "type": "string" },
    "effects": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cash": { "type": "number", "description": "dollars of the event's era" },
        "confidence": { "type": "number" },
        "student_needs": { "type": "object", "additionalProperties": { "type": "number" } },
        "applicants": { "type": "number", "exclusiveMinimum": 0, "description": "multiplies applicants at the next move-in" },
        "town_boarding": { "type": "number", "exclusiveMinimum": 0, "description": "multiplies town boarding beds from now on" },
        "hire_faculty": {
          "type": "object",
          "required": ["name", "teaching", "research"],
          "additionalProperties": false,
          "properties": {
            "name": { "type": "string" },
            "teaching": { "type": "integer", "minimum": 0, "maximum": 100 },
            "research": { "type": "integer", "minimum": 0, "maximum": 100 }
          }
        },
        "faculty_leaves": { "type": "string", "description": "name of a faculty member hired by an earlier event" },
        "scholarship": { "type": "number" }
      }
    },
    "codex": { "type": "array", "items": { "type": "string" }, "description": "History Book entries this event unlocks" },
    "sources": { "type": "array", "items": { "$ref": "#/$defs/source" } },
    "verified": { "type": "boolean" }
  },
  "allOf": [
    { "if": { "properties": { "kind": { "const": "historical" } } }, "then": { "required": ["date", "date_precision", "sources"] } },
    { "if": { "properties": { "kind": { "const": "generic" } } }, "then": { "required": ["window"] } }
  ]
}
