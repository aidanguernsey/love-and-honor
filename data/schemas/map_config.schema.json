{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Map pipeline inputs (tools/map_pipeline)",
  "type": "object",
  "required": ["center", "projection", "heightmap_resolution_m", "dem", "osm", "line_widths_m", "output_prefix"],
  "additionalProperties": false,
  "patternProperties": { "^_": {} },
  "properties": {
    "$schema": { "type": "string" },
    "center": {
      "type": "object",
      "required": ["lat", "lon", "checked"],
      "additionalProperties": false,
      "patternProperties": { "^_": {} },
      "properties": {
        "lat": { "type": "number", "minimum": -90, "maximum": 90 },
        "lon": { "type": "number", "minimum": -180, "maximum": 180 },
        "checked": { "type": "boolean" }
      }
    },
    "projection": { "const": "local_transverse_mercator" },
    "heightmap_resolution_m": { "type": "number", "exclusiveMinimum": 0 },
    "dem": {
      "type": "object",
      "required": ["service_url", "download_crs_epsg", "download_pixel_m", "download_margin_m"],
      "additionalProperties": false,
      "properties": {
        "service_url": { "type": "string", "pattern": "^https://" },
        "download_crs_epsg": { "type": "integer" },
        "download_pixel_m": { "type": "number", "exclusiveMinimum": 0 },
        "download_margin_m": { "type": "number", "minimum": 0 }
      }
    },
    "osm": {
      "type": "object",
      "required": ["overpass_urls", "retries_per_server", "margin_m"],
      "additionalProperties": false,
      "properties": {
        "overpass_urls": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^https://" } },
        "retries_per_server": { "type": "integer", "minimum": 1 },
        "margin_m": { "type": "number", "minimum": 0 }
      }
    },
    "line_widths_m": {
      "type": "object",
      "required": ["footway", "cycleway", "service", "residential", "tertiary", "secondary", "primary", "railway", "stream", "river"],
      "additionalProperties": { "type": "number", "exclusiveMinimum": 0 }
    },
    "output_prefix": { "type": "string", "pattern": "^[a-z0-9_]+$" }
  }
}
