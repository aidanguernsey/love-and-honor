{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Academic calendar (§6.2): yearly phases and named events, as month-day anchors",
  "type": "object",
  "required": ["verified", "phases", "events"],
  "additionalProperties": false,
  "patternProperties": { "^_": {} },
  "$defs": {
    "monthDay": { "type": "string", "pattern": "^(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$" }
  },
  "properties": {
    "$schema": { "type": "string" },
    "verified": { "type": "boolean" },
    "phases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["start", "id", "name", "term", "classes"],
        "additionalProperties": false,
        "patternProperties": { "^_": {} },
        "properties": {
          "start": { "$ref": "#/$defs/monthDay" },
          "id": { "type": "string", "pattern": "^[a-z_]+$" },
          "name": { "type": "string", "minLength": 1 },
          "term": { "enum": ["fall", "spring", null] },
          "classes": { "type": "boolean" },
          "students_away": { "type": "boolean" }
        }
      }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["start", "end", "name"],
        "additionalProperties": false,
        "properties": {
          "start": { "$ref": "#/$defs/monthDay" },
          "end": { "$ref": "#/$defs/monthDay" },
          "name": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
